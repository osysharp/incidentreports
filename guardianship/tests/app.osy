// The producer's test project for Osysharp.IncidentReports.Guardianship — a youth football club: a coach reports a
// player's sprained ankle at training, the club's welfare officer reviews it, and the player's parents — linked by
// Osysharp.Guardianship — are the ones told.
app IncidentReportsGuardianshipKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Guardianship@0;
  use Osysharp.IncidentReports@0;
  // Osysharp.IncidentReports.Guardianship, the package under test, is not written: it arrives by itself because this app
  // uses IncidentReports and Guardianship, which it completes (`osy lock` includes it and says so).
  use Osysharp.Workflow;
  use Osysharp.Ui;
}
