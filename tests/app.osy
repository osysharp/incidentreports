// The producer's test project for Osysharp.IncidentReports — a summer day camp by a lake: counsellors file what happens
// (a camper's grazed knee, a canoe that nearly tipped over, a broken window), the camp director reviews, the campers are
// accounts their parents made and never sign in to (Osysharp.UserAccounts), and a camper's parents are told about anything
// that happened to their child. Run it: `osy test kits/incident-reports/tests`.
app IncidentReportsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Csv@0;
  use Osysharp.IncidentReports@0;
  use Osysharp.Storage;
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
