// Everything the camp says to the kit: its roles and its answers to the kit's policies, its settings, who must be told
// about a camper, and what it does when the kit tells it something.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.IncidentReports;

[Role] enum CampRole { Authenticator, Parent, Counsellor, Cook, Director }

policy IsStaff => RoleGrant.Any(g => g.Member == user && (g.Role == CampRole.Counsellor || g.Role == CampRole.Cook || g.Role == CampRole.Director));
policy IsDirector => RoleGrant.Any(g => g.Member == user && g.Role == CampRole.Director);

/// Staff file reports; parents do not (they are told, and acknowledge).
policy ReportsIncidents => IsStaff;
/// The director reviews every report.
policy ReviewsIncidents => IsDirector;

/// A parent makes an account for the child they bring, which the child never signs in to.
policy MakesManagedAccounts => RoleGrant.Any(g => g.Member == user && g.Role == CampRole.Parent);

app.Accounts = new AccountsSetup { AppName = "Pine Lake Day Camp", SignupRole = CampRole.Parent };
app.Incidents = new IncidentsSetup { AuthorityWarningHours = 24, Organisation = "Pine Lake Day Camp" };

/// Who to call about a camper — the camp's own record, kept by staff.
entity CamperContact {
  [Required] Principal Camper;
  [Required] Principal Contact;
  security { allow read when IsStaff; allow create when IsDirector; }
}

/// The camp's answer to the kit's question: a camper's contacts are told about anything that happened to them.
public class CampContacts : IIncidentContacts {
  public List<Principal> ContactsFor(Principal person) {
    return CamperContact.Where(c => c.Camper == person).Select(c => c.Contact).Take(10).ToList();
  }
}

/// What the camp heard from the kit, one row per event — a stand-in for the mail it would send.
entity Heard {
  [MaxLength(40)] string Event = "";
  [MaxLength(200)] string Detail = "";
  security { allow read when IsAuthenticated; }
}

[On] void HearReported(IncidentReported e) { new Heard { Event = "reported", Detail = e.Report.Number + ":" + e.Report.Location }; }
[On] void HearReviewStarted(IncidentReviewStarted e) { new Heard { Event = "reviewstarted", Detail = e.Report.Number }; }
[On] void HearClosed(IncidentClosed e) { new Heard { Event = "closed", Detail = e.Report.Number }; }
[On] void HearReopened(IncidentReopened e) { new Heard { Event = "reopened", Detail = e.Report.Number }; }
[On] void HearReportable(IncidentReportable e) { new Heard { Event = "reportable", Detail = e.Report.Number + ":" + e.Report.Authority }; }
[On] void HearDue(IncidentAuthorityReportDue e) { new Heard { Event = "authoritydue", Detail = e.Report.Number }; }
[On] void HearOverdue(IncidentAuthorityReportOverdue e) { new Heard { Event = "authorityoverdue", Detail = e.Report.Number }; }
[On] void HearAssigned(CorrectiveActionAssigned e) { new Heard { Event = "assigned", Detail = e.Action.What + ":" + e.Action.Owner.DisplayName }; }
[On] void HearCompleted(CorrectiveActionCompleted e) { new Heard { Event = "completed", Detail = e.Action.What }; }
[On] void HearActionOverdue(CorrectiveActionOverdue e) { new Heard { Event = "actionoverdue", Detail = e.Action.What }; }
[On] void HearNotice(IncidentNoticeSent e) { new Heard { Event = "notice", Detail = e.Notice.Recipient.DisplayName + ":" + e.Notice.About.Name }; }
[On] void HearAcknowledged(IncidentNoticeAcknowledged e) { new Heard { Event = "acknowledged", Detail = e.Notice.Recipient.DisplayName }; }
